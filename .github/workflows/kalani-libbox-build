
name: Build Android libbox

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    name: Build sing-box Android AAR
    runs-on: ubuntu-24.04

    steps:
      - name: Checkout workflow repository
        uses: actions/checkout@v4

      - name: Checkout sing-box source
        uses: actions/checkout@v4
        with:
          repository: SagerNet/sing-box
          ref: v1.15.0-alpha.13
          path: sing-box

      - name: Set up Go
        uses: actions/setup-go@v5
        with:
          go-version: '1.25.5'
          cache: true
          cache-dependency-path: sing-box/go.sum

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Install Android SDK and NDK
        run: |
          yes | sdkmanager --licenses
          sdkmanager --install "platforms;android-35" "ndk;28.0.13004108"

      - name: Install gomobile tools
        working-directory: sing-box
        run: |
          go install github.com/sagernet/gomobile/cmd/gomobile@v0.1.12
          go install github.com/sagernet/gomobile/cmd/gobind@v0.1.12
          echo "$(go env GOPATH)/bin" >> "$GITHUB_PATH"

      - name: Build Android libbox
        working-directory: sing-box
        run: |
          go run ./cmd/internal/build_libbox -target android -platform android/arm64

      - name: Upload Android AAR files
        uses: actions/upload-artifact@v4
        with:
          name: kalani-libbox-1.15.0-alpha.13-arm64
          path: |
            sing-box/libbox.aar
            sing-box/libbox-legacy.aar
          if-no-files-found: error
          retention-days: 14
